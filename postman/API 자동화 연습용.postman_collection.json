        {
          "name": "06. 현금영수증 금액 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const result = pm.response.json();\r",
                  "const payment = result.body[0];\r",
                  "const cashReceiptAmount = payment.cashReceiptAmount;\r",
                  "\r",
                  "const bodyFields = [\r",
                  "    \"paymentId\",\r",
                  "    \"resultCode\",\r",
                  "    \"resultMessage\",\r",
                  "    \"cashReceiptAmount\"\r",
                  "]\r",
                  "\r",
                  "const cashReceiptAmountFields = [\r",
                  "    \"npointCashAmount\",\r",
                  "    \"giftCardCashAmount\",\r",
                  "    \"primaryCashAmount\",\r",
                  "    \"envDepositCashAmount\",\r",
                  "    \"primaryPayMeans\",\r",
                  "    \"totalCashAmount\",\r",
                  "    \"supplyCashAmount\",\r",
                  "    \"vatCashAmount\"\r",
                  "]\r",
                  "\r",
                  "pm.test(\"현금영수증 금액 조회에 성공했습니다.\", function() {\r",
                  "    pm.expect(result.code).to.eql(\"Success\");\r",
                  "})\r",
                  "\r",
