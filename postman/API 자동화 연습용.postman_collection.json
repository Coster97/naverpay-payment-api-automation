        {
          "name": "04. 결제내역조회 (특정)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const result = pm.response.json();\r",
                  "const body = result.body;\r",
                  "const payment = result.body.list[0];\r",
                  "const paymentSettleInfo = payment.settleInfo;\r",
                  "\r",
                  "const bodyFields = [\r",
                  "    \"list\",\r",
                  "    \"totalCount\",\r",
                  "    \"responseCount\",\r",
                  "    \"totalPageCount\",\r",
                  "    \"currentPageNumber\"\r",
                  "]\r",
                  "\r",
                  "const paymentHistoryFields = [\r",
                  "  \"paymentId\",\r",
                  "  \"payHistId\",\r",
                  "  \"admissionState\",\r",
                  "  \"admissionTypeCode\",\r",
                  "  \"admissionYmdt\",\r",
                  "  \"tradeConfirmYmdt\",\r",
                  "  \"totalPayAmount\",\r",
                  "  \"applyPayAmount\",\r",
                  "  \"primaryPayAmount\",\r",
                  "  \"npointPayAmount\",\r",
                  "  \"giftCardPayAmount\",\r",
                  "  \"discountPayAmount\",\r",
                  "  \"taxScopeAmount\",\r",
                  "  \"taxExScopeAmount\",\r",
                  "  \"environmentDepositAmount\",\r",
                  "  \"merchantName\",\r",
                  "  \"merchantId\",\r",
                  "  \"masterMerchantName\",\r",
                  "  \"masterMerchantId\",\r",
                  "  \"merchantPayKey\",\r",
                  "  \"merchantUserKey\",\r",
                  "  \"primaryPayMeans\",\r",
                  "  \"cardCorpCode\",\r",
                  "  \"cardNo\",\r",
                  "  \"cardAuthNo\",\r",
                  "  \"cardInstCount\",\r",
                  "  \"usedCardPoint\",\r",
                  "  \"bankCorpCode\",\r",
                  "  \"bankAccountNo\",\r",
                  "  \"productName\",\r",
                  "  \"settleInfo\",\r",
                  "  \"merchantExtraParameter\",\r",
                  "  \"extraDeduction\",\r",
                  "  \"useCfmYmdt\",\r",
                  "  \"cancelRequester\"\r",
                  "]\r",
                  "\r",
                  "const settleInfoFields = [\r",
                  "  \"settleCreated\",\r",
                  "  \"totalSettleAmount\",\r",
                  "  \"totalCommissionAmount\",\r",
                  "  \"primarySettleAmount\",\r",
                  "  \"primaryCommissionAmount\",\r",
                  "  \"npointSettleAmount\",\r",
                  "  \"npointCommissionAmount\",\r",
                  "  \"giftCardSettleAmount\",\r",
                  "  \"giftCardCommissionAmount\",\r",
                  "  \"discountSettleAmount\",\r",
                  "  \"discountCommissionAmount\"\r",
                  "]\r",
                  "\r",
                  "pm.test(\"특정 결제번호의 결제내역조회에 성공했습니다.\", function() {\r",
                  "    pm.expect(result.code).to.eql(\"Success\");\r",
                  "})\r",
                  "\r",
                  "pm.test(`결제내역 필수 필드가 정상 조회됩니다.`, function() {\r",
                  "    bodyFields.forEach(field => {\r",
                  "        pm.expect(body).to.have.property(field);\r",
                  "    })\r",
                  "})\r",
                  "\r",
                  "pm.test(`정산관련 필수 필드가 정상 조회됩니다.`, function() {\r",
                  "    settleInfoFields.forEach(field => {\r",
                  "        pm.expect(paymentSettleInfo).to.have.property(field);\r",
                  "    })\r",
                  "})"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
