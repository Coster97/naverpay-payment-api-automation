        {
          "name": "05. 결제내역조회 (기간)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const result = pm.response.json();\r",
                  "const paymentList = result.body.list;\r",
                  "const paymentListLength = paymentList.length;\r",
                  "const payment = result.body.list[paymentListLength-1];\r",
                  "const paymentId = pm.environment.get(\"paymentId\");\r",
                  "\r",
                  "const requiredFields = [\r",
                  "    \"paymentId\",\r",
                  "    \"payHistId\",\r",
                  "    \"admissionState\",\r",
                  "    \"admissionTypeCode\",\r",
                  "    \"admissionYmdt\",\r",
                  "    \"tradeConfirmYmdt\",\r",
                  "    \"totalPayAmount\",\r",
                  "    \"applyPayAmount\",\r",
                  "    \"primaryPayAmount\",\r",
                  "    \"npointPayAmount\",\r",
                  "    \"giftCardPayAmount\",\r",
                  "    \"discountPayAmount\",\r",
                  "    \"taxScopeAmount\",\r",
                  "    \"taxExScopeAmount\",\r",
                  "    \"environmentDepositAmount\",\r",
                  "    \"merchantName\",\r",
                  "    \"merchantId\",\r",
                  "    \"merchantPayKey\",\r",
                  "    \"merchantUserKey\",\r",
                  "    \"primaryPayMeans\",\r",
                  "    \"cardCorpCode\",\r",
                  "    \"cardNo\",\r",
                  "    \"cardAuthNo\",\r",
                  "    \"cardInstCount\",\r",
                  "    \"usedCardPoint\",\r",
                  "    \"bankCorpCode\",\r",
                  "    \"bankAccountNo\",\r",
                  "    \"productName\",\r",
                  "    \"settleInfo\",\r",
                  "    \"merchantExtraParameter\",\r",
                  "    \"extraDeduction\",\r",
                  "    \"useCfmYmdt\",\r",
                  "    \"masterMerchantId\",\r",
                  "    \"masterMerchantName\"\r",
                  "];\r",
                  "\r",
                  "const settleFields = [\r",
                  "   \"settleCreated\",\r",
                  "   \"totalSettleAmount\",\r",
                  "   \"totalCommissionAmount\",\r",
                  "   \"primarySettleAmount\",\r",
                  "   \"primaryCommissionAmount\",\r",
                  "   \"npointSettleAmount\",\r",
                  "   \"npointCommissionAmount\",\r",
                  "   \"giftCardSettleAmount\",\r",
                  "   \"giftCardCommissionAmount\",\r",
                  "   \"discountSettleAmount\",\r",
                  "   \"discountCommissionAmount\"\r",
                  "];\r",
                  "\r",
                  "\r",
                  "pm.test(\"결제내역 조회에 성공했습니다.\", function() {\r",
                  "    pm.expect(result.code).to.eql(\"Success\")\r",
                  "})\r",
                  "\r",
                  "pm.test(\"결제내역 배열이 존재합니다.\", function () {\r",
                  "    pm.expect(paymentList).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(`기간 내 결제내역이 ${paymentListLength}건 조회됩니다.`, function() {\r",
                  "    pm.expect(true).to.be.true;\r",
                  "})\r",
                  "\r",
                  "//atmost 이하\r",
                  "//atleast 이상\r",
                  "//atblow 미만\r",
                  "//atabove 초과\r",
                  "if(paymentListLength > 1){\r",
                  "    pm.test(\"결제내역이 admissionYmdt 기준 오름차순으로 정렬됩니다.\", function(){\r",
                  "    for(let i = 0; i < paymentListLength - 1; i ++) {\r",
                  "            const current = Number(paymentList[i].admissionYmdt)\r",
                  "            const next = Number(paymentList[i+1].admissionYmdt);\r",
                  "\r",
                  "            pm.expect(current).to.be.at.most(next);\r",
                  "        } \r",
                  "    })\r",
                  "}\r",
                  "\r",
                  "pm.test(\"기간 내 결제번호가 정상 조회됩니다.\", function() {\r",
                  "    pm.expect(payment.paymentId).to.eql(paymentId);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"결제내역 필수 필드가 정상 조회됩니다.\", function(){\r",
                  "    requiredFields.forEach(field => {\r",
                  "        pm.expect(payment).to.have.property(field);\r",
                  "    })\r",
                  "})\r",
                  "\r",
                  "pm.test(\"정산관련 필수 필드가 정상 조회됩니다.\", function() {\r",
                  "    settleFields.forEach(field => {\r",
                  "        pm.expect(payment.settleInfo).to.have.property(field);\r",
                  "    })\r",
                  "})\r",
                  "\r",
                  "pm.test(\"마스터 가맹점의 정보가 정상 노출됩니다.\", function() {\r",
                  "    pm.expect(payment.masterMerchantName).to.eql(\"네이버페이 샌드박스 가맹점\");\r",
                  "    pm.expect(payment.masterMerchantId).to.eql(\"np_tvueg710454\");\r",
                  "})\r",
                  "\r",
                  "pm.test(\"하위 가맹점 결제건 정보가 정상 노출됩니다.\", function() {\r",
                  "    pm.expect(payment.merchantName).to.eql(\"샌드박스 가맹점\");\r",
                  "    pm.expect(payment.merchantId).to.eql(\"np_xgfjs740776\");\r",
                  "})\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const now = new Date();\r",
                  "\r",
                  "const yyyy = now.getFullYear();\r",
                  "const MM = String(now.getMonth() + 1).padStart(2, '0');\r",
                  "const dd = String(now.getDate()).padStart(2, '0');\r",
                  "\r",
                  "const HH = String(now.getHours()).padStart(2, '0');\r",
                  "const mm = String(now.getMinutes()).padStart(2, '0');\r",
                  "const ss = String(now.getSeconds()).padStart(2, '0');\r",
                  "\r",
                  "pm.collectionVariables.set(\"startTime\", `${yyyy}${MM}${dd}000000`);\r",
                  "pm.collectionVariables.set(\"endTime\", `${yyyy}${MM}${dd}${HH}${mm}${ss}`);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
